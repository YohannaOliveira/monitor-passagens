# --- Fontes de tarifas ---
# Descoberta (preço em cache). Token em Travelpayouts > Perfil > API token.
TRAVELPAYOUTS_TOKEN=
# Opcional: o endpoint v3 não foi conferido na doc oficial; ajuste se necessário.
# TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com/aviasales/v3/prices_for_dates

# Validação (preço em tempo real): ignav (padrão) ou serpapi.
VALIDATION_PROVIDER=ignav
# Ignav: chave em ignav.com (primeiras 1.000 requisições grátis, depois US$ 2 por 1.000).
IGNAV_API_KEY=
# IGNAV_BASE_URL=https://ignav.com/api/fares/round-trip
# SerpApi (alternativa, usada só se VALIDATION_PROVIDER=serpapi)
SERPAPI_API_KEY=
# SERPAPI_BASE_URL=https://serpapi.com/search.json
# Teto de validações por mês, contado no SQLite (use abaixo da cota gratuita do provedor).
VALIDATION_MONTHLY_LIMIT=900
MAX_VALIDATIONS_PER_RUN=10

# --- WhatsApp (CallMeBot) ---
# Número com DDI, ex.: +5511999999999. A APIKEY vem da ativação em callmebot.com.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# CALLMEBOT_URL=https://api.callmebot.com/whatsapp.php

# --- Regras de busca ---
ORIGINS=GRU,CGH
# Todas as capitais, exceto Vitória, São Paulo, Rio de Janeiro e Maceió.
DESTINATIONS=RBR,MAO,MCP,BEL,PVH,BVB,PMW,SLZ,THE,FOR,NAT,JPA,REC,AJU,SSA,CNF,BSB,GYN,CGB,CGR,CWB,FLN,POA
DEPART_START=2027-05-03
DEPART_END=2027-05-12
RETURN_BY=2027-05-16
MIN_DAYS=4
MAX_DAYS=10
MAX_PRICE_BRL=1000
# Candidatas = preço em cache <= MAX_PRICE_BRL * DISCOVERY_MARGIN
DISCOVERY_MARGIN=1.3
# Novo alerta da mesma oferta só se o preço cair pelo menos este valor (R$)
MIN_NOTIFY_DROP_BRL=1

# --- Execução ---
# Horas de espera contadas após o término de cada rodada
INTERVAL_HOURS=24
DB_PATH=monitor.db
# true = não envia WhatsApp, só registra no log o que enviaria
DRY_RUN=true
